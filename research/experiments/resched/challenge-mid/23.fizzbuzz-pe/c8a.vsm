imm ui"0x3EAAAAAB" $lr32/1000
iadd $lm0v $aluf $nowrite; l1bmd+0 $lm0v $lbi
imm ui"0x00000078" $t; fvadd $aluf -$lr32 $ls0v; l1bmd $lbi $ln0v
imm ui"0x3E4CCCCD" $lr40/1000; fvmul $mauf $lr32 $nowrite
iand $mauf $t $omr1; fvmul $ls0v $aluf $nowrite
iand $mauf $t $omr2; hvpassar/$imr1 -$lr40 $nowrite
imm ui"0xFFFFBBBB" $ln0v/$imr2; hvfma $mauf $lr32 $lr32e $omr1/$imr2
imm ui"0x0000FFFF" $ln0v/$imr1
