lpassa $subpeid $r0
iadd $aluf $aluf $r0
imm i"1" $s1/1000
imm i"8" $s2/1000
imm i"9" $s3/1000
nop
iadd $r0 $s1 $r1
iadd $r0 $s2 $r2
iadd $r0 $s3 $r3

imm f"1.0" $s15/1000
zero $ln0v
zero $ln8v
nop

ixor $m0 $r0v $omr1
fpassa $s15 $n0v/$imr1
ixor $m1 $r0v $omr1
fpassa $s15 $n4v/$imr1
ixor $m2 $r0v $omr1
fpassa $s15 $n8v/$imr1
ixor $m3 $r0v $omr1
fpassa $s15 $n12v/$imr1